{
  "name": "shoe",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run worker -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:shop": "npm run dev -w apps/storefront",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin",
    "build:shop": "npm run build -w apps/storefront",
    "db:generate": "npm run generate -w @shoe/db",
    "db:migrate": "npm run migrate -w @shoe/db",
    "db:deploy": "npm run deploy -w @shoe/db",
    "db:seed": "npm run seed -w @shoe/db",
    "db:studio": "npm run studio -w @shoe/db",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/admin && npm run typecheck -w apps/storefront",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
