# ---- apps/api/.env ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shoe
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stridex
S3_ACCESS_KEY=minio_user
S3_SECRET_KEY=minio_password
# Where browsers fetch objects, bucket segment included. Unset means
# S3_ENDPOINT/S3_BUCKET, which is what MinIO serves — so leave it alone locally.
# On R2 the public origin has no bucket in it: https://pub-<hash>.r2.dev
# S3_PUBLIC_URL=
# The bucket exists already and this process must not create or configure it.
# Every hosted S3 lookalike refuses PutBucketPolicy — R2 does not implement it —
# and uploads await the bucket check, so leaving this off in production turns
# every upload into an error about bucket administration. MinIO manages its own.
# S3_MANAGED_BUCKET=true
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5175,http://localhost:5174

# ---- payments ----
# All three are required — the API refuses to boot without them, because the
# alternative is a checkout that fails at the first Pay on a 401 from an API
# nobody has logged into. Get test keys from the Razorpay dashboard; a
# `rzp_live_*` key outside production is refused.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set on the webhook in the dashboard, and NOT the same string as the key
# secret. Signing with the wrong one fails every webhook with a 401 that looks
# exactly like an attack.
RAZORPAY_WEBHOOK_SECRET=
# What the customer reads at the top of the Razorpay modal.
RAZORPAY_DISPLAY_NAME=StrideX

# ---- mail ----
# Absolute bases for links in email. Not derived from CORS_ORIGINS, which is an
# allowlist with no canonical first entry. Storefront is 5174, admin is 5175.
STOREFRONT_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175
# Empty SMTP_HOST = emails are rendered and logged, not sent. Fill these in to
# send for real. Port 465 is treated as implicit TLS; 587 and 1025 are not.
#   Resend:  smtp.resend.com : 465,  SMTP_USER=resend,       SMTP_PASSWORD=<re_... API key>
#   Brevo:   smtp-relay.brevo.com : 587,  SMTP_USER=<login>, SMTP_PASSWORD=<SMTP key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StrideX <no-reply@stridex.local>"
SEED_ADMIN_EMAIL=admin@shoe.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---- apps/admin/.env ----
VITE_API_URL=http://localhost:4000/api/admin

# ---- apps/storefront/.env ----
VITE_API_URL=http://localhost:4000/api/storefront
# Origins only, for <link rel="preconnect"> in index.html. Split from the URL
# above because preconnect takes an origin and that one carries a path — and
# because images come from object storage the API never routes through.
VITE_API_ORIGIN=http://localhost:4000
VITE_MEDIA_ORIGIN=http://localhost:9000
# The site's own canonical origin. Used for absolute URLs inside JSON-LD and
# robots.txt — a search engine cannot resolve a relative one.
VITE_SITE_URL=http://localhost:5174
