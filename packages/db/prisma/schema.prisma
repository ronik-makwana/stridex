// Shoe e-commerce — full schema.
// Conventions: uuid PKs (gen_random_uuid), timestamptz, Decimal(12,2) money,
// no soft deletes (status enums instead), Postgres enums, snake_case columns.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// Prisma 7: the connection URL lives in prisma.config.ts (Migrate) and in the
// PrismaPg adapter passed to PrismaClient (runtime), not here.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── enums ───────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EntityStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CollectionType {
  MANUAL
  DYNAMIC
}

enum MatchType {
  ALL
  ANY
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentRecordStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  REFUND
  VOID
}

/**
 * What the customer asked for, and which rulebook answers it.
 * A cancellation is a promise not yet kept — nothing has shipped, so it is
 * self-serve and refunds in full. A return is a promise kept and then undone:
 * the parcel exists, somebody has to receive it back, and only then does money
 * move. Two words for two different sets of guards, on one table because they
 * end in the same place.
 */
enum RefundRequestType {
  CANCELLATION
  RETURN
}

/**
 * REQUESTED → APPROVED → RECEIVED → COMPLETED, with REJECTED and WITHDRAWN as
 * the two ways out. A cancellation skips to RECEIVED in the same transaction
 * that cancels the order — there is no parcel to wait for.
 * RECEIVED is the one that matters: it is the only status that has ever moved
 * stock, and it is what stops a second click restocking the same pair twice.
 */
enum RefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
  RECEIVED
  COMPLETED
}

/**
 * The money's own state, and deliberately not the request's. A request can be
 * RECEIVED while its refund is still PROCESSING at the provider, and the two
 * must be able to say so independently (§11).
 * Nothing but a webhook writes SUCCEEDED.
 */
enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

/**
 * Why, in the customer's words rather than an operator's. Read on the returns
 * queue and worth counting: DAMAGED trending on one SKU is a supplier problem,
 * WRONG_SIZE trending is a size-guide problem, and a free-text box answers
 * neither question.
 */
enum RefundReason {
  CHANGED_MIND
  WRONG_SIZE
  DAMAGED
  NOT_AS_DESCRIBED
  WRONG_ITEM
  LATE_DELIVERY
  OTHER
}

enum CheckoutStatus {
  ACTIVE
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

/**
 * One lifecycle, two things holding: a reservation holds stock, a redemption
 * holds a use of a coupon. They are the same problem — something set aside for
 * one customer, until a moment — and they are released, expired and consumed at
 * exactly the same points, so they share an enum rather than drifting apart.
 */
enum HoldStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
}

/**
 * Which of the three things a discount takes money off. The rules for each are
 * different enough that one flag beats one table per kind: a product discount
 * reduces the lines it matches, an order discount reduces the cart total, and a
 * shipping discount reduces the delivery charge.
 */
enum DiscountKind {
  PRODUCT
  ORDER
  SHIPPING
}

/**
 * What a product discount matches against. Products, or a set they belong to.
 */
enum DiscountAppliesTo {
  PRODUCTS
  CATEGORIES
  COLLECTIONS
}

enum DiscountEligibility {
  ALL_CUSTOMERS
  SPECIFIC_CUSTOMERS
}

/**
 * The gate before a discount applies at all. Measured against the *matching*
 * lines for a product discount, not the whole cart — "spend ₹2,000 on running
 * shoes" is a different promise from "spend ₹2,000".
 */
enum DiscountMinRequirement {
  NONE
  PURCHASE_AMOUNT
  ITEM_QUANTITY
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum AddressType {
  SHIPPING
  BILLING
}

// ─────────────────────────────── auth ───────────────────────────────

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  phone           String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  addresses               Address[]
  cart                    Cart?
  wishlist                Wishlist?
  orders                  Order[]
  reviews                 Review[]
  checkoutSessions        CheckoutSession[]
  couponRedemptions       CouponRedemption[]
  couponEligibility       CouponCustomer[]
  orderStatusChanges      OrderStatusHistory[]
  inventoryTransactions   InventoryTransaction[]
  refundRequests          RefundRequest[]          @relation("RefundRequestCustomer")
  // Staff, not customers. Named relations because a request points at a person
  // twice — whose order it is, and who decided — and Prisma cannot guess which.
  refundDecisions         RefundRequest[]          @relation("RefundRequestDecidedBy")
  refundsInitiated        Refund[]                 @relation("RefundInitiatedBy")

  @@index([role, status])
  @@index([createdAt])
  // Declared here, not only in raw SQL: Prisma diffs the database against this
  // file, and an index it cannot see is an index it generates a DROP for on the
  // next `migrate dev`. Partial indexes (the WHERE-clause ones in
  // prisma/sql/003) are invisible to that diff and stay in raw SQL.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// Same shape as PasswordResetToken and deliberately not merged with it behind a
// `purpose` column: the two have different lifetimes, and one table would mean
// every reset lookup carries a filter that a missed WHERE turns into a
// verification link that resets a password.
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String
  state        String
  country      String   @default("IN")
  postalCode   String   @map("postal_code")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // An address a checkout is pointing at cannot be deleted out from under it —
  // see the SetNull on those two columns, which is why these are separate
  // named relations rather than one list.
  checkoutShipping CheckoutSession[] @relation("CheckoutShippingAddress")
  checkoutBilling  CheckoutSession[] @relation("CheckoutBillingAddress")

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── catalog ───────────────────────────────

model Brand {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String       @unique
  logoUrl   String?      @map("logo_url")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([status, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

model Category {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  parentId    String?      @map("parent_id") @db.Uuid
  level       Int          @default(0)
  position    Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]       @relation("CategoryTree")
  products Product[]
  coupons  CouponCategory[]

  @@index([parentId, position])
  @@index([status])
  @@map("categories")
}

model Attribute {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String        @unique
  type         AttributeType
  unit         String?
  isFilterable Boolean       @default(false) @map("is_filterable")
  isSuggested  Boolean       @default(false) @map("is_suggested")
  position     Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  values            AttributeValue[]
  productAttributes ProductAttribute[]

  @@index([position])
  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String
  slug        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttribute[]

  @@unique([attributeId, slug])
  @@index([attributeId, position])
  @@map("attribute_values")
}

model VariantOption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values                VariantOptionValue[]
  productVariantOptions ProductVariantOption[]

  @@index([position])
  @@map("variant_options")
}

model VariantOptionValue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantOptionId String   @map("variant_option_id") @db.Uuid
  value           String
  slug            String
  swatchHex       String?  @map("swatch_hex")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variantOption VariantOption             @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)
  assignments   VariantOptionAssignment[]

  @@unique([variantOptionId, slug])
  @@index([variantOptionId, position])
  @@map("variant_option_values")
}

// ─────────────────────────────── products ───────────────────────────────

model Product {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId     String?      @map("brand_id") @db.Uuid
  categoryId  String?      @map("category_id") @db.Uuid
  title       String
  slug        String       @unique
  description String?
  status      EntityStatus @default(DRAFT)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  media          ProductMedia[]
  attributes     ProductAttribute[]
  variantOptions ProductVariantOption[]
  variants       ProductVariant[]
  collections    CollectionProduct[]
  tags           ProductTag[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  coupons        CouponProduct[]

  @@index([status, createdAt])
  @@index([brandId])
  @@index([categoryId])
  // Fuzzy admin search. Trigram GIN beats ILIKE '%x%' once the table grows.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  url       String
  altText   String?   @map("alt_text")
  type      MediaType @default(IMAGE)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductAttribute {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  attributeId      String   @map("attribute_id") @db.Uuid
  attributeValueId String?  @map("attribute_value_id") @db.Uuid
  valueText        String?  @map("value_text")
  valueNumber      Decimal? @map("value_number") @db.Decimal(12, 2)
  valueBoolean     Boolean? @map("value_boolean")
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeId, attributeValueId])
  @@index([attributeId, attributeValueId])
  @@map("product_attributes")
}

model ProductVariantOption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantOptionId String   @map("variant_option_id") @db.Uuid
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantOption VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Restrict)

  @@unique([productId, variantOptionId])
  @@index([productId, position])
  @@map("product_variant_options")
}

model ProductVariant {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  mediaId        String?      @map("media_id") @db.Uuid
  sku            String       @unique
  barcode        String?
  price          Decimal      @db.Decimal(12, 2)
  compareAtPrice Decimal?     @map("compare_at_price") @db.Decimal(12, 2)
  position       Int          @default(0)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   ProductMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  optionAssignments VariantOptionAssignment[]
  inventory         Inventory?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  checkoutItems     CheckoutItem[]
  reservations      InventoryReservation[]

  @@index([productId, position])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_variants_sku_trgm_idx")
  @@map("product_variants")
}

model VariantOptionAssignment {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_assignments")
}

// ─────────────────────────────── tags ───────────────────────────────

/**
 * Free-form labels, created by typing them on a product rather than managed
 * from a screen of their own. `slug` is what makes two spellings of the same
 * word one tag — 'Summer Sale' and 'summer sale' both normalise to
 * `summer-sale` — while `name` keeps whichever casing was typed first.
 */
model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  // 'Every product tagged sale' reads the join from the tag's side.
  @@index([tagId])
  @@map("product_tags")
}

// ─────────────────────────────── collections ───────────────────────────────

model Collection {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?        @map("image_url")
  type        CollectionType @default(MANUAL)
  matchType   MatchType      @default(ALL) @map("match_type")
  status      EntityStatus   @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  products CollectionProduct[]
  rules    CollectionRule[]
  coupons  CouponCollection[]

  @@index([status])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@map("collection_products")
}

model CollectionRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  field        String
  operator     String
  value        Json
  groupId      Int      @default(0) @map("group_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, groupId])
  @@map("collection_rules")
}

// ─────────────────────────────── inventory ───────────────────────────────

model Inventory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String   @unique @map("variant_id") @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@map("inventories")
}

model InventoryTransaction {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryId     String                   @map("inventory_id") @db.Uuid
  type            InventoryTransactionType
  quantity        Int
  referenceType   String?                  @map("reference_type")
  referenceId     String?                  @map("reference_id") @db.Uuid
  note            String?
  createdByUserId String?                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@map("inventory_transactions")
}

// ─────────────────────────────── cart & wishlist ───────────────────────────────

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ─────────────────────────────── reviews ───────────────────────────────

// Deliberately has no `verified_purchase` column. Whether someone bought the
// product is derived per query — does this user have a PAID order containing a
// variant of it — because storing it means keeping it true forever: a refund, a
// chargeback or a returned order all falsify a stored flag and nothing would
// go back and fix it.
//
// Nor is there a denormalised rating average on `products`. The average is one
// grouped query per page; a stored column is a second source of truth that
// drifts the first time a review is hidden by a moderator.
model Review {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String       @map("product_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  rating    Int
  body      String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One review per person per product. This constraint is the guard: a second
  // attempt is a 409, not a silently created duplicate.
  @@unique([productId, userId])
  // The product page reads published reviews newest-first, and the summary
  // groups by rating over the same set.
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

// ─────────────────────────────── orders ───────────────────────────────

model Order {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?       @map("user_id") @db.Uuid
  orderNumber        String        @unique @map("order_number")
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount     Decimal       @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  /**
   * The part of `discountAmount` that came off delivery rather than goods.
   */
  shippingDiscount   Decimal       @default(0) @map("shipping_discount") @db.Decimal(12, 2)
  /**
   * The delivery service the customer paid for, copied from the session. The
   * warehouse reads this: an order charged for next-day that ships on the slow
   * van is a refund, and the amount alone does not say which was bought.
   */
  shippingMethod     String        @default("STANDARD") @map("shipping_method")
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency           String        @default("INR")
  placedAt           DateTime?     @map("placed_at") @db.Timestamptz(6)
  /**
   * When the parcel arrived, stamped by the DELIVERED transition.
   * Derivable from `order_status_history` and denormalised anyway, because the
   * return window is counted from it on every order read — and a window whose
   * deadline needs a join to a history table is a window that gets computed in
   * the browser instead. DELIVERED can be corrected backwards to SHIPPED, so
   * this is rewritten by the transition rather than written once.
   */
  deliveredAt        DateTime?     @map("delivered_at") @db.Timestamptz(6)
  /**
   * When the confirmation email was handed to the provider — not when it was
   * queued, and not when it was read.
   * The order is created inside a transaction and the email is queued *after*
   * it commits, because queuing inside would let the worker read an order that
   * does not exist yet, or send a confirmation for one that then rolled back.
   * That leaves a gap: a process that dies between COMMIT and `queue.add` loses
   * the email with nothing recording that it should have sent one.
   * This column closes it. A sweep finds PAID orders past a grace period with
   * this still null and queues them — the cheap half of a transactional outbox,
   * without the table or the poller, because the failure being guarded against
   * is a missing email rather than a lost payment.
   */
  confirmationSentAt DateTime?     @map("confirmation_sent_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  items             OrderItem[]
  addresses         OrderAddress[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  checkoutSession   CheckoutSession?
  couponRedemptions CouponRedemption[]
  refundRequests    RefundRequest[]
  refunds           Refund[]

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([userId, createdAt])
  @@index([paymentStatus, confirmationSentAt])
  @@map("orders")
}

model OrderItem {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  variantId              String?  @map("variant_id") @db.Uuid
  productTitle           String   @map("product_title")
  sku                    String
  variantOptions         Json?    @map("variant_options")
  unitPrice              Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity               Int
  totalPrice             Decimal  @map("total_price") @db.Decimal(12, 2)
  /**
   * The item discount: what a coupon took off *this line*. A coupon restricted
   * to one brand discounts two lines out of four, and the order has to record
   * which — deriving it later means re-deriving it from prices that have moved.
   * A catalog markdown is not this. `compare_at_price` is already inside
   * `unit_price`; subtracting it here as well discounts the product twice.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /** Snapshot, like every other field here: the code as it was at purchase.
   */
  discountCode           String?  @map("discount_code")
  discountAmount         Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /**
   * This line's share of the order-wide discount, split by largest remainder so
   * the shares sum to exactly `orders.discount_amount`. ₹100 across three lines
   * is 33.34 / 33.33 / 33.33, and the stray paisa has to land somewhere
   * deterministic — at refund time it is far too late to decide where.
   */
  orderDiscountAllocated Decimal  @default(0) @map("order_discount_allocated") @db.Decimal(12, 2)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  refundRequestItems RefundRequestItem[]
  refundItems        RefundItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  type         AddressType
  fullName     String      @map("full_name")
  phone        String
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  state        String
  country      String      @default("IN")
  postalCode   String      @map("postal_code")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

model OrderStatusHistory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────────────────── checkout ───────────────────────────────

/**
 * The quote. A cart is a wish and an order is a fact; this is the ten minutes
 * in between, during which stock is actually held and a price is actually
 * promised.
 * Nothing about it is derivable from the cart afterwards: `checkout_items`
 * snapshots the price and the labels, `inventory_reservations` says what is
 * held and until when, and `expires_at` is the only thing standing between an
 * abandoned tab and stock nobody can buy. The countdown the UI draws is
 * decoration — this column is the authority (§2).
 * There is no `tax_amount`, here or anywhere. See `orders.tax_amount`, which
 * survives from the admin build, is written 0, and is never rendered.
 */
model CheckoutSession {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  status           CheckoutStatus @default(ACTIVE)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  subtotal         Decimal        @db.Decimal(12, 2)
  /**
   * The order-wide discount. Per-line discounts live on `checkout_items`.
   */
  discountAmount   Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount   Decimal        @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  /**
   * Taken off the delivery charge by a shipping discount. Kept apart from the
   * rate so the summary can show both — a charge that silently arrives lower is
   * one the customer cannot check.
   */
  shippingDiscount Decimal        @default(0) @map("shipping_discount") @db.Decimal(12, 2)
  /**
   * Which delivery service was chosen, as a code from the static table in
   * `shipping.methods.ts`. The rate is quoted from this and the settings row,
   * never sent by the client (§21).
   */
  shippingMethod   String         @default("STANDARD") @map("shipping_method")
  totalAmount      Decimal        @map("total_amount") @db.Decimal(12, 2)
  currency         String         @default("INR")

  shippingAddressId String? @map("shipping_address_id") @db.Uuid
  billingAddressId  String? @map("billing_address_id") @db.Uuid
  /**
   * Null until the webhook lands. Unique: one session produces one order (§8).
   */
  orderId           String? @unique @map("order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a saved address must not delete the checkout
  // that used it. The order keeps its own copy in `order_addresses` regardless.
  shippingAddress Address? @relation("CheckoutShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress  Address? @relation("CheckoutBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  items        CheckoutItem[]
  reservations InventoryReservation[]
  redemptions  CouponRedemption[]
  payments     Payment[]

  @@index([userId, createdAt])
  // The expiry sweep reads exactly this: ACTIVE sessions past their moment.
  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

/**
 * The price snapshot, and the labels that go with it. A product can be repriced
 * while a customer is paying; payment charges what is here, and an expired
 * session gets a fresh quote at current prices (§6).
 * `product_title`, `sku` and `variant_options` carry forward into `order_items`
 * verbatim, which is what lets an order render years later without joining to a
 * product that has since been renamed, recategorised or archived (§19).
 */
model CheckoutItem {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutSessionId      String   @map("checkout_session_id") @db.Uuid
  variantId              String   @map("variant_id") @db.Uuid
  productTitle           String   @map("product_title")
  sku                    String
  variantOptions         Json?    @map("variant_options")
  unitPrice              Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity               Int
  totalPrice             Decimal  @map("total_price") @db.Decimal(12, 2)
  /**
   * This line's own discount. See `order_items.discount_amount`.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * The code that won this line, as text. At most one: several codes can sit on
   * a cart, but a line takes the best of them and never two (see the allocator
   * in discount.engine.ts).
   */
  discountCode           String?  @map("discount_code")
  discountAmount         Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /**
   * This line's share of the order discount, by largest remainder.
   */
  orderDiscountAllocated Decimal  @default(0) @map("order_discount_allocated") @db.Decimal(12, 2)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  // Cascade rather than Restrict: a session is ten minutes of intent, and it
  // must not be the thing that stops an admin deleting a variant. The order is
  // where this becomes permanent, and `order_items` keeps its own snapshot.
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /**
   * One line per variant. Adding the same variant twice adds up (§15).
   */
  @@unique([checkoutSessionId, variantId])
  @@map("checkout_items")
}

/**
 * A row, not a counter — the single most important shape in this migration.
 * `inventories.reserved_quantity` says *how much* is held. Only a row says *by
 * whom* and *until when*, which is what lets a sweep release exactly the
 * abandoned ones instead of guessing at a number that has drifted (§1, §24).
 */
model InventoryReservation {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutSessionId String     @map("checkout_session_id") @db.Uuid
  variantId         String     @map("variant_id") @db.Uuid
  quantity          Int
  status            HoldStatus @default(ACTIVE)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  session CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  // Restrict, unlike the checkout line above: this row is the record of stock
  // that was taken out of circulation. Deleting the variant under it would
  // leave `reserved_quantity` holding units nothing explains.
  variant ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([checkoutSessionId, variantId])
  // The sweep: ACTIVE holds past their moment, in one index scan.
  @@index([status, expiresAt])
  // 'What is currently held on this variant', for reconciliation against
  // `inventories.reserved_quantity`.
  @@index([variantId, status])
  @@map("inventory_reservations")
}

// ─────────────────────────────── coupons ───────────────────────────────

/**
 * `used_count` is incremented atomically and checked by affected rows, exactly
 * like inventory: two customers racing for the last use of a coupon is the same
 * problem as two racing for the last pair of shoes, and it has the same answer
 * (§20).
 */
model Coupon {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /**
   * Stored upper-case. The service normalises; the index is what enforces one.
   */
  code              String       @unique
  description       String?
  /**
   * Every discount here is a code the customer types. Automatic discounts are
   * a different feature — they need no code, and giving them a unique one to
   * satisfy this column would be inventing data to fit a table.
   */
  kind              DiscountKind @default(PRODUCT)
  type              CouponType
  value             Decimal      @db.Decimal(12, 2)
  minCartValue      Decimal?     @map("min_cart_value") @db.Decimal(12, 2)
  /**
   * Caps a percentage coupon. '20% off, up to ₹500'.
   */
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  startsAt          DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?    @map("ends_at") @db.Timestamptz(6)
  usageLimit        Int?         @map("usage_limit")
  /**
   * 1 is the "one use per customer" tick. Left null it is unlimited per person,
   * bounded only by `usageLimit` across everybody.
   */
  perUserLimit      Int?         @map("per_user_limit")
  usedCount         Int          @default(0) @map("used_count")
  status            EntityStatus @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  /**
   * PRODUCT discounts only. Null on an order or shipping discount, which apply
   * to the cart rather than to anything in it.
   */
  appliesTo         DiscountAppliesTo?     @map("applies_to")
  eligibility       DiscountEligibility    @default(ALL_CUSTOMERS)
  minRequirement    DiscountMinRequirement @default(NONE) @map("min_requirement")
  /**
   * Read when `minRequirement` is ITEM_QUANTITY; `minCartValue` when it is PURCHASE_AMOUNT.
   */
  minQuantity       Int?                   @map("min_quantity")
  /**
   * SHIPPING discounts only: the rate above which this does not apply. "Free
   * delivery, but not on next-day." Null means every rate qualifies.
   */
  maxShippingAmount Decimal?               @map("max_shipping_amount") @db.Decimal(12, 2)

  /**
   * Which *other* kinds this one may sit alongside in the same checkout. Three
   * flags rather than a list, because there are exactly three kinds and a
   * table of pairs would be a join to answer a yes/no question.
   */
  combinesWithProduct  Boolean @default(false) @map("combines_with_product")
  combinesWithOrder    Boolean @default(false) @map("combines_with_order")
  combinesWithShipping Boolean @default(false) @map("combines_with_shipping")

  products    CouponProduct[]
  categories  CouponCategory[]
  collections CouponCollection[]
  customers   CouponCustomer[]
  redemptions CouponRedemption[]

  @@index([kind, status])
  @@index([status, endsAt])
  @@map("coupons")
}

/**
 * Scoping, and it is deliberately empty by default: a coupon with no rows in
 * either join table applies to the whole catalog. Rows narrow it.
 */
model CouponProduct {
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

/**
 * Mirrors `inventory_reservations`, and for the same reason: a coupon is *held*
 * when the session is created, *consumed* when the webhook confirms payment,
 * and *released* when the session expires or fails. Without the hold, a
 * single-use code is spent by two people who both have it open (§20).
 * `unique(coupon_id, order_id)` is the belt to that braces. Postgres treats
 * NULLs as distinct, so it constrains confirmed orders — one redemption per
 * coupon per order — while leaving open holds alone.
 */
model CouponCollection {
  couponId     String @map("coupon_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid

  coupon     Coupon     @relation(fields: [couponId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([couponId, collectionId])
  @@index([collectionId])
  @@map("coupon_collections")
}

/**
 * Named customers, for a discount that is not for everybody. Cascades on the
 * user: an account that is gone cannot be on a list of who may use a code.
 */
model CouponCustomer {
  couponId String @map("coupon_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([couponId, userId])
  @@index([userId])
  @@map("coupon_customers")
}

model CouponRedemption {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId          String     @map("coupon_id") @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  checkoutSessionId String     @map("checkout_session_id") @db.Uuid
  /**
   * Null until the webhook confirms.
   */
  orderId           String?    @map("order_id") @db.Uuid
  discountAmount    Decimal    @map("discount_amount") @db.Decimal(12, 2)
  status            HoldStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  coupon  Coupon          @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  /**
   * `per_user_limit` is counted from here.
   */
  @@index([couponId, userId])
  @@index([status, createdAt])
  @@map("coupon_redemptions")
}

// ─────────────────────────────── testimonials ───────────────────────────────

/**
 * Brand testimonials — deliberately **not** product reviews.
 * A review is a customer's opinion of one product, tied to their account and to
 * a purchase, and it belongs on that product's page. A testimonial is
 * merchandising: a quote somebody chose to put on the front page, often from a
 * press cutting, an email, or a customer who agreed to be named. Sourcing one
 * from the other would mean a shop could promote a five-star review to the home
 * page without asking, and could never quote anything that did not arrive
 * through the review form.
 */
model Testimonial {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote      String
  authorName String       @map("author_name")
  /**
   * 'Marathon runner, Surat' — context, not a job title. Optional.
   */
  authorRole String?      @map("author_role")
  /**
   * Optional: not every quote comes with a number of stars, and a made-up one is worse than none.
   */
  rating     Int?
  imageUrl   String?      @map("image_url")
  status     EntityStatus @default(DRAFT)
  /**
   * Drag order on the admin screen; the front page renders it.
   */
  position   Int          @default(0)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, position])
  @@map("testimonials")
}

// ─────────────────────────────── settings ───────────────────────────────

/**
 * One row, and the only reason it exists in this migration: shipping is a
 * setting, not a table. One flat rate with a free-above threshold, in a place a
 * human can change it — no zones, no bands, no rate matrix.
 * It carries exactly what checkout reads today. The admin settings screen
 * (phase 9) will extend it; an ALTER on a one-row config table is not the
 * migration this file exists to avoid.
 */
model StoreSettings {
  /**
   * Fixed: there is one store. The default is what makes the upsert trivial.
   */
  id                    String   @id @default("store")
  shippingFlatRate      Decimal  @default(99) @map("shipping_flat_rate") @db.Decimal(12, 2)
  /**
   * Null means shipping is never free.
   */
  freeShippingThreshold Decimal? @default(1999) @map("free_shipping_threshold") @db.Decimal(12, 2)
  /**
   * How long after delivery a return may be raised. Configuration rather than a
   * constant: "we are extending returns to 14 days over Diwali" is a decision
   * somebody makes on a Tuesday, not a deploy.
   * Read at request time only. A window that shortened must not retroactively
   * close a return somebody was already entitled to raise yesterday, so the
   * deadline is recomputed from `delivered_at` on every read and the customer
   * sees today's rule.
   */
  returnWindowDays      Int      @default(7) @map("return_window_days")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

// ─────────────────────────────── payments ───────────────────────────────

model Payment {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /**
   * Null between the attempt and the webhook, which is the whole window this
   * table exists to survive. The order is written when the provider confirms
   * (§8); until then a payment belongs to a checkout session and nothing else.
   */
  orderId           String?             @map("order_id") @db.Uuid
  /**
   * What was being paid for. Set at the attempt and kept afterwards: it is how
   * a webhook arriving with only a provider id finds its way home, and how a
   * payment with no order yet knows whose it is.
   */
  checkoutSessionId String?             @map("checkout_session_id") @db.Uuid
  provider          String
  providerPaymentId String              @map("provider_payment_id")
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  status            PaymentRecordStatus @default(PENDING)
  method            String?
  /**
   * The double-click guard, and the only one that counts. A disabled button is
   * UX; this unique index is correctness — the same key arriving twice returns
   * the stored payment and creates nothing (§7, §13). Nullable because rows
   * written by the webhook or by reconciliation have no client key, and
   * Postgres treats NULLs as distinct under a unique index.
   */
  idempotencyKey    String?             @unique @map("idempotency_key")
  /**
   * Whatever the provider actually said, kept verbatim for the 2am read.
   */
  providerResponse  Json?               @map("provider_response")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull rather than Cascade: a payment outlives the session that started
  // it. Losing the row would lose the evidence that money moved.
  session      CheckoutSession?     @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@unique([provider, providerPaymentId])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([checkoutSessionId])
  @@map("payments")
}

model PaymentTransaction {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId             String                 @map("payment_id") @db.Uuid
  type                  PaymentTransactionType
  amount                Decimal                @db.Decimal(12, 2)
  providerTransactionId String?                @map("provider_transaction_id")
  metadata              Json?
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

// ─────────────────────────────── refunds ───────────────────────────────

/**
 * What the customer asked for. Not money — intent.
 * The separation from `refunds` below is the whole design. A request is a
 * conversation: raised, approved or rejected, a parcel waited for. A refund is
 * an amount at a provider, which either settled or did not. Collapsing them
 * into one table means a rejected request and a failed refund become the same
 * row, and "we said no" stops being distinguishable from "the bank said no".
 * A cancellation writes one of these too, already RECEIVED, so that both roads
 * to a refund leave the same paper trail and the returns queue is the one place
 * to read what was asked and what was decided.
 */
model RefundRequest {
  id      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String              @map("order_id") @db.Uuid
  /**
   * Denormalised from the order so the queue can scope by customer without a
   * join, and so the row survives an order whose user was set null.
   */
  userId  String              @map("user_id") @db.Uuid
  type    RefundRequestType
  status  RefundRequestStatus @default(REQUESTED)
  reason  RefundReason
  /**
   * The customer's own words, optional except when the reason is OTHER — which
   * the schema enforces, not the database.
   */
  comment String?

  /**
   * What this *would* refund, priced when the request was raised.
   * Not the refund: the amount is recomputed from the lines at the moment money
   * actually moves, because an item can be rejected from the return in between.
   * Kept anyway so the queue can show a figure without re-running the split,
   * and so a dispute can read what the customer was quoted.
   */
  estimatedAmount Decimal @map("estimated_amount") @db.Decimal(12, 2)

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  /**
   * Required on a rejection. The customer is told this, so it is written for them.
   */
  decisionNote    String?   @map("decision_note")
  /**
   * When the parcel was physically taken back in. The only timestamp that has
   * ever moved stock.
   */
  receivedAt      DateTime? @map("received_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User  @relation("RefundRequestCustomer", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: the record of a decision outlives the account that made it.
  decidedBy User? @relation("RefundRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  items   RefundRequestItem[]
  refunds Refund[]

  @@index([orderId, createdAt])
  // The queue: everything waiting on a person, oldest first.
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("refund_requests")
}

/**
 * Which lines, and how many of each.
 * Quantities rather than whole lines because two pairs of the same shoe on one
 * line is one row, and sending back one of them is the ordinary case.
 * `restockedQuantity` and `unsellableQuantity` are what make receiving a parcel
 * idempotent and partial at the same time: two of three pairs arrived today,
 * the third next week, and neither the ledger nor a second click can double
 * count. They sum to at most `quantity`, enforced by the service.
 */
model RefundRequestItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String  @map("request_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  quantity    Int
  /**
   * This line's share of the refund, split from the snapshot columns on
   * `order_items` — its own discount and its share of the order-wide one, both
   * already allocated at checkout precisely so this sum is not a re-derivation.
   */
  amount      Decimal @db.Decimal(12, 2)

  /**
   * Units that went back into sellable stock.
   */
  restockedQuantity  Int @default(0) @map("restocked_quantity")
  /**
   * Units that came back and were written off — worn, damaged, not resellable.
   */
  unsellableQuantity Int @default(0) @map("unsellable_quantity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  request   RefundRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: this row says units are owed back. Losing it because
  // an order line was deleted would leave a refund nothing explains.
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  /**
   * One row per line per request — asking for the same line twice is a bug.
   */
  @@unique([requestId, orderItemId])
  @@index([orderItemId])
  @@map("refund_request_items")
}

/**
 * Money going back, and the mirror of `payments`.
 * Everything true of a payment is true here: the provider is the authority, the
 * row is written PENDING before the call, and **nothing but a webhook writes
 * SUCCEEDED** (§8, §12). A refund this service believed in that the provider
 * never made is the same failure as an order with no payment behind it.
 */
model Refund {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  /**
   * The captured payment this takes money back out of.
   */
  paymentId String  @map("payment_id") @db.Uuid
  /**
   * Null for a discretionary refund an operator issued against no request —
   * goodwill, a shipping mistake, a partial for a mark on a box.
   */
  requestId String? @map("request_id") @db.Uuid

  amount   Decimal      @db.Decimal(12, 2)
  currency String       @default("INR")
  status   RefundStatus @default(PENDING)
  reason   RefundReason
  /**
   * Internal. Shown to staff, never to the customer.
   */
  note     String?

  provider         String
  /**
   * Null until the provider accepts it. Their id, for the 2am reconciliation.
   */
  providerRefundId String? @map("provider_refund_id")
  /**
   * Required, unlike a payment's. Every refund in this system is issued by our
   * own code, so there is always a key to generate — and the unique index is
   * what makes a double-clicked Refund button move money once (§7, §13).
   */
  idempotencyKey   String  @unique @map("idempotency_key")

  /**
   * Null when the system issued it: a self-serve cancellation.
   */
  initiatedByUserId String? @map("initiated_by_user_id") @db.Uuid
  /**
   * What the provider said when it declined. Shown to staff, kept for disputes.
   */
  failureReason     String? @map("failure_reason")
  providerResponse  Json?   @map("provider_response")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  request     RefundRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  initiatedBy User?          @relation("RefundInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  items RefundItem[]

  /**
   * Their id, once, per provider. The same guard `payments` has, and for the
   * same reason: a webhook replayed after a restore must find the row rather
   * than create a second one. Nullable, and Postgres treats NULLs as distinct,
   * so refunds not yet accepted do not collide.
   */
  @@unique([provider, providerRefundId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
  @@index([requestId])
  @@map("refunds")
}

/**
 * What the money was for, line by line.
 * A copy of the request's lines rather than a pointer to them, because a refund
 * can be issued without a request at all, and because an approval may refund
 * fewer units than were asked for. This is the breakdown that was actually
 * paid, which is what a credit note has to be able to print years later.
 */
model RefundItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundId    String  @map("refund_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  quantity    Int
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
  @@map("refund_items")
}
