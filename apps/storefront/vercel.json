{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stridex-api.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://stridex-api.onrender.com/api/storefront/sitemap.xml"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
